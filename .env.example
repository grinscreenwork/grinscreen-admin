# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=            # server-only. NEVER prefix with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GRINSCREEN_REELS_BUCKET=grinscreen-reels
GRINSCREEN_IMAGES_BUCKET=grinscreen-images

# Postgres (used only by scripts/migrate.mjs)
SESSION_URL=

# Admin auth: sign in with any Supabase Auth user (Authentication -> Users).
# Turn OFF public sign-ups in Supabase (Authentication -> Sign In / Providers), otherwise login is refused.
# ALLOW_OPEN_SIGNUPS=true   # NOT recommended: lets anyone who registers become an admin
SESSION_SECRET=                 # 32+ random bytes, e.g. `openssl rand -hex 32`

# Talks to the public site so published changes show up immediately
CLIENT_SITE_URL=http://localhost:3000
REVALIDATE_SECRET=              # must match the client site's REVALIDATE_SECRET

# Booking emails, sent through Gmail SMTP
GMAIL_USER=                     # e.g. grinscreen.work@gmail.com
GMAIL_APP_PASSWORD=             # Google Account > Security > App passwords (needs 2-Step Verification)
NOTIFY_SECRET=                  # random 32+ chars; must match the client site's NOTIFY_SECRET
ADMIN_URL=http://localhost:3001 # this admin's own public URL (used for the "Open in admin" link)
